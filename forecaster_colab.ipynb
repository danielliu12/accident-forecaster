"""
Interactive risk map (v3).

- County polygons (choropleth) shaded by risk — geometry is geographic, so
  it stays county-sized at every zoom level. Fallback when the GeoJSON
  can't be fetched: L.circle with a radius in *meters* (also zoom-correct).
- Hover tooltip explains WHY a county is hot: EMS opportunity rank and
  injured patients/yr, weather conditions in the horizon and the peak-risk
  window, active incidents, and the county's top inbound commuter origins.
- Click a county to draw its commuter inflow lines (Census LODES): where
  the people traveling through it come from, line weight ~ share.
- LIVE MODE: while the page is open it re-fetches Open-Meteo every 15
  minutes for the dynamic counties, recomputes the weather multipliers in
  the browser, and recolors the map. Incidents refresh on notebook re-run.
"""
from __future__ import annotations

import json

import config


def build_map(scores, geo, origins, path, hours=48, trail=None):
    fips_by_norm = geo["name_to_fips"] if geo else {}
    import re
    norm = lambda s: re.sub(r"[^a-z]", "", str(s).lower())  # noqa: E731

    counties_js = {}
    for r in scores.itertuples():
        fips = fips_by_norm.get(norm(r.county))
        cen = (geo["centroids"].get(fips) if geo and fips
               else config.COUNTY_CENTROIDS.get(r.county))
        counties_js[r.county] = {
            "fips": fips, "risk": float(r.risk_score),
            "rank": int(r.rank), "injured": float(r.injured_patients),
            "serious": float(r.serious_cases),
            "opportunity": float(r.opportunity_score),
            "metro": r.metro, "dynamic": bool(r.dynamic),
            "events": int(r.active_events),
            "incBoost": float(r.incident_boost),
            "lift": float(r.weather_lift),
            "wx": r.wx_conditions, "peak": r.wx_peak,
            "trailing": float(r.trailing_weight),
            "lat": cen[0] if cen else None,
            "lon": cen[1] if cen else None,
            "flows": (origins.get(fips, {}) if fips else {}),
        }

    features = geo["features"] if geo else []
    payload = {
        "counties": counties_js,
        "trail": [
            {"lat": e["lat"], "lon": e["lon"], "type": e["type"],
             "desc": e.get("desc", ""), "county": e["county"],
             "mag": e["magnitude"], "imp": e["importance"],
             "decay": e["decay"], "age_h": e["age_h"]}
            for e in (trail or []) if e.get("lat") is not None],
        "features": features,
        "hours": hours,
        "exposure": _exposure_vec(),
        "dynamicCentroids": {
            c: {"lat": counties_js[c]["lat"], "lon": counties_js[c]["lon"]}
            for c, v in counties_js.items()
            if v["dynamic"] and v["lat"] is not None},
    }

    html = _TEMPLATE.replace("__PAYLOAD__", json.dumps(payload))
    with open(path, "w") as f:
        f.write(html)


def _exposure_vec():
    vec = []
    for wd in range(7):
        prof = config.WEEKDAY_HOURLY if wd < 5 else config.WEEKEND_HOURLY
        vec.extend(prof)
    mean = sum(vec) / len(vec)
    return [round(v / mean, 4) for v in vec]


_TEMPLATE = r"""<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Indiana Accident Risk — Live</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style>
html,body{height:100%;margin:0;font-family:system-ui,sans-serif}
#map{height:100%;transition:margin-right .25s}
body.panel-open #map{margin-right:360px}
.panel-box{background:#fff;padding:8px 12px;border-radius:6px;font-size:13px;
box-shadow:0 1px 4px rgba(0,0,0,.3)}
.leaflet-tooltip.hint{font-size:12px;font-weight:600;padding:3px 8px}
.leaflet-interactive{cursor:pointer}
#side{position:fixed;top:0;right:-380px;width:360px;height:100%;background:#fff;
box-shadow:-2px 0 10px rgba(0,0,0,.25);transition:right .25s;z-index:1200;
overflow-y:auto;box-sizing:border-box;padding:16px 18px}
body.panel-open #side{right:0}
#side h2{margin:0 44px 4px 0;font-size:18px}
#side .badge{display:inline-block;padding:1px 9px;border-radius:10px;color:#fff;font-weight:700}
#side .sec{margin:14px 0 0}
#side .sec h3{margin:0 0 4px;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:#777}
#side .sec div{font-size:13.5px;line-height:1.5}
#closebtn{position:absolute;top:10px;right:12px;border:none;background:#eee;
border-radius:50%;width:28px;height:28px;font-size:15px;cursor:pointer}
.origin-row{display:flex;justify-content:space-between;border-bottom:1px solid #f0f0f0;padding:2px 0}
.bar{height:6px;background:#08519c;border-radius:3px;margin-top:2px}
@media (max-width:700px){#side{width:85%}body.panel-open #map{margin-right:0}}
</style></head><body><div id="map"></div>
<div id="side"><button id="closebtn" onclick="closePanel()">×</button><div id="sidecontent"></div></div>
<script>
const D = __PAYLOAD__;
const map = L.map('map').setView([39.9,-86.3],7);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
 {attribution:'&copy; OpenStreetMap · risk: EMS opportunity × weather × exposure · flows: Census LODES'}).addTo(map);

const byFips = {};
Object.entries(D.counties).forEach(([name,c])=>{ if(c.fips) byFips[c.fips]={name,...c}; });

function color(r){return r>60?'#67000d':r>40?'#a50f15':r>25?'#cb181d':r>15?'#ef3b2c':r>8?'#fb6a4a':r>4?'#fcae91':'#fee5d9';}

// ---------- side panel ----------
function sec(title, body){ return `<div class="sec"><h3>${title}</h3><div>${body}</div></div>`; }
function panelHTML(c,name){
  let h = `<h2>${name} County <span class="badge" style="background:${color(c.risk)}">risk ${c.risk.toFixed(1)}</span></h2>`;
  h += `<div style="color:#777;font-size:12.5px">${c.metro==='other_in'?'outside core metros':c.metro+' market'} · next ${D.hours}h</div>`;
  h += sec('Why this county scores here',
    `#${c.rank} statewide in EMS-measured crash injuries — ${Math.round(c.injured).toLocaleString()} injured patients/yr, ${Math.round(c.serious)} serious cases.`);
  if(c.dynamic){
    h += sec('Weather (next '+D.hours+'h)',
      `${c.wx}. Overall risk lift <b>×${c.lift.toFixed(2)}</b>${c.peak?`; peak-risk window <b>${c.peak}</b>`:''}.`);
  } else {
    h += sec('Weather', '<i>Static tier — baseline only, no live weather feed for this county.</i>');
  }
  let inc='';
  if(c.events>0) inc += `<b>⚠ ${c.events} active incident(s)</b> on the live 511 feed.<br>`;
  if(c.trailing>0.05) inc += `◷ Trailing incidents: decayed weight <b>${c.trailing.toFixed(1)}</b> — recent significant events still echo here.<br>`;
  if(inc) inc += `Combined incident boost ×${c.incBoost.toFixed(2)}.`;
  h += sec('Incidents', inc || 'None live or trailing.');
  if(c.flows && c.flows.origins && c.flows.origins.length){
    let rows = `<div class="origin-row"><span>local (lives in-county)</span><b>${((c.flows.internal_share||0)*100).toFixed(0)}%</b></div>`;
    const mx = Math.max(...c.flows.origins.map(o=>o.share));
    c.flows.origins.forEach(o=>{
      rows += `<div class="origin-row"><span>${o.label}</span><b>${(o.share*100).toFixed(1)}%</b></div>`+
              `<div class="bar" style="width:${(o.share/mx*100).toFixed(0)}%"></div>`;
    });
    rows += `<div style="color:#777;font-size:12px;margin-top:6px">Census commuter data — blue lines on the map show these inflows. Counties above are candidates to include in this hotspot's ad geography.</div>`;
    h += sec('Who travels through (origins)', rows);
  }
  return h;
}
function incidentPanelHTML(t){
  const age = t.age_h<48 ? `${Math.round(t.age_h)}h ago` : `${(t.age_h/24).toFixed(1)} days ago`;
  let h = `<h2>◷ Past incident <span class="badge" style="background:#b45f06">fading</span></h2>`;
  h += sec('What', `${t.type}${t.desc?`<br><span style="color:#555">${t.desc}</span>`:''}`);
  h += sec('Where / when', `${t.county} County · last seen on the live feed ${age}.`);
  h += sec('Current weight', `Magnitude ${t.mag}/5, decayed to <b>${t.imp.toFixed(2)}</b> (${(t.decay*100).toFixed(0)}% remaining; 48h half-life). It fades from the map as it decays.`);
  return h;
}
function openPanel(html){ document.getElementById('sidecontent').innerHTML=html; document.body.classList.add('panel-open'); setTimeout(()=>map.invalidateSize(),260); }
function closePanel(){ document.body.classList.remove('panel-open'); flowLayer.clearLayers(); setTimeout(()=>map.invalidateSize(),260); }

// ---------- flows ----------
let flowLayer = L.layerGroup().addTo(map);
function drawFlows(c){
  flowLayer.clearLayers();
  if(!(c.flows&&c.flows.origins&&c.lat)) return;
  c.flows.origins.forEach(o=>{
    if(o.lat==null) return;
    L.polyline([[o.lat,o.lon],[c.lat,c.lon]],{color:'#08519c',weight:1+o.share*30,opacity:.65}).addTo(flowLayer);
    L.circleMarker([o.lat,o.lon],{radius:4,color:'#08519c',fillOpacity:.9}).addTo(flowLayer);
  });
}

// ---------- county layer ----------
let geoLayer=null, fallbackLayer=null;
function styleFor(c){return {color:'#555',weight:c.events>0?2.5:1,
  dashArray:c.events>0?'4':null,fillColor:color(c.risk),fillOpacity:.62};}
const hoverStyle={weight:3,color:'#111',fillOpacity:.8};

function wireCounty(layer,c,name){
  layer.bindTooltip(`${name} County — click for details`,{sticky:true,className:'hint',direction:'top'});
  layer.on('mouseover',()=>layer.setStyle(hoverStyle));
  layer.on('mouseout',()=>layer.setStyle(styleFor(c)));
  layer.on('click',()=>{openPanel(panelHTML(c,name)); drawFlows(c);});
}
function render(){
  if(D.features && D.features.length){
    if(geoLayer) map.removeLayer(geoLayer);
    geoLayer = L.geoJSON({type:'FeatureCollection',features:D.features},{
      style: f=>{const c=byFips[f.id]; return c?styleFor(c):{fillColor:'#eee',color:'#999',weight:.5,fillOpacity:.3};},
      onEachFeature:(f,layer)=>{ const c=byFips[f.id]; if(c) wireCounty(layer,c,c.name); }}).addTo(map);
  } else {
    if(fallbackLayer) map.removeLayer(fallbackLayer);
    fallbackLayer=L.layerGroup().addTo(map);
    Object.entries(D.counties).forEach(([name,c])=>{
      if(c.lat==null) return;
      const layer=L.circle([c.lat,c.lon],{radius:13000,...styleFor(c)}).addTo(fallbackLayer);
      wireCounty(layer,c,name);
    });
  }
}
render();

// ---------- trailing incident markers (opacity = decay) ----------
const trailLayer = L.layerGroup().addTo(map);
D.trail.forEach(t=>{
  const m=L.circleMarker([t.lat,t.lon],{radius:5+t.mag*1.6,color:'#b45f06',
    fillColor:'#e69138',fillOpacity:0.15+0.65*t.decay,opacity:0.25+0.7*t.decay,weight:2}).addTo(trailLayer);
  m.bindTooltip('Past incident — click for details',{sticky:true,className:'hint',direction:'top'});
  m.on('click',()=>openPanel(incidentPanelHTML(t)));
});

// ---------- legend + live status ----------
const legend=L.control({position:'bottomright'});
legend.onAdd=()=>{const d=L.DomUtil.create('div','panel-box');
 d.innerHTML='<b>County risk (next '+D.hours+'h)</b><br>'+
 [[60,'severe'],[25,'elevated'],[8,'moderate'],[0,'baseline']].map(
  ([v,t])=>`<span style="color:${color(v+0.1)}">■</span> ${t}`).join(' &nbsp;')+
 '<br>dashed = active incidents · <span style="color:#e69138">●</span> fading past incidents'+
 '<br>click any county or marker for details'+
 '<br><span id="livestatus" style="color:#666">live weather: starting…</span>';
 return d;};
legend.addTo(map);

// ---------- LIVE MODE: refresh weather every 15 min ----------
const MULT={rl:1.25,rm:1.5,rh:1.8,sl:1.5,sm:1.8,sh:2.2,fz:2.5,fog:1.4,dark:1.25,wind:1.15};
function wmult(p,s,t,vis,g,day,code){
  let m=1;
  if([56,57,66,67].includes(code)||(p>0.1&&t<=0)) m*=MULT.fz;
  else if(s>2.5)m*=MULT.sh; else if(s>1)m*=MULT.sm; else if(s>0.1)m*=MULT.sl;
  else if(p>7.6)m*=MULT.rh; else if(p>2.5)m*=MULT.rm; else if(p>0.1)m*=MULT.rl;
  if(vis<1000)m*=MULT.fog; if(!day)m*=MULT.dark; if(g>40)m*=MULT.wind;
  return Math.min(m,3.5);
}
async function refreshWeather(){
  const names=Object.keys(D.dynamicCentroids);
  if(!names.length) return;
  const lats=names.map(n=>D.dynamicCentroids[n].lat).join(',');
  const lons=names.map(n=>D.dynamicCentroids[n].lon).join(',');
  const url=`https://api.open-meteo.com/v1/forecast?latitude=${lats}&longitude=${lons}`+
   `&hourly=precipitation,snowfall,temperature_2m,visibility,wind_gusts_10m,is_day,weather_code`+
   `&forecast_days=${Math.min(7,Math.ceil(D.hours/24))}&timezone=America%2FIndiana%2FIndianapolis`;
  try{
    let payload=await (await fetch(url)).json();
    if(!Array.isArray(payload)) payload=[payload];
    names.forEach((name,i)=>{
      const h=payload[i].hourly; let total=0;
      for(let k=0;k<Math.min(D.hours,h.time.length);k++){
        const ts=new Date(h.time[k]);
        const ex=D.exposure[((ts.getDay()+6)%7)*24+ts.getHours()];
        total+=wmult(h.precipitation[k],h.snowfall[k],h.temperature_2m[k],
                     h.visibility[k],h.wind_gusts_10m[k],h.is_day[k],h.weather_code[k])*ex;
      }
      const c=D.counties[name];
      c.lift=total/D.hours;
      c._live=c.opportunity*total*c.incBoost;
    });
    Object.values(D.counties).forEach(c=>{ if(c._live===undefined) c._live=c.opportunity*D.hours*c.incBoost; });
    const mx=Math.max(...Object.values(D.counties).map(c=>c._live));
    Object.entries(D.counties).forEach(([n,c])=>{c.risk=100*c._live/mx; if(c.fips&&byFips[c.fips])byFips[c.fips].risk=c.risk;});
    render();
    document.getElementById('livestatus').textContent='live weather: updated '+new Date().toLocaleTimeString();
  }catch(e){
    document.getElementById('livestatus').textContent='live weather: refresh failed (showing last data)';
  }
}
refreshWeather();
setInterval(refreshWeather, 15*60*1000);
</script></body></html>
"""
