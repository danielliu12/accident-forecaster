"""
Translate county risk into an ad plan (v2).

Outputs:
  budget_shares : metro-level blend of static Phase 2 shares and live
                  county risk (counties roll up via COUNTY_TO_METRO;
                  unmapped counties form the 'other_in' bucket, reported
                  but excluded from the Phase 2 blend).
  county_targets: ranked county list for Google Ads county location
                  targeting, with suggested within-budget weight.
  cluster_mix   : per-metro keyword-cluster mix from Phase 2 efficiency.
  dayparting    : high-risk hours per metro with suggested bid adjustments.
"""
from __future__ import annotations

import pandas as pd

import config


def load_phase2():
    prio = pd.read_csv(config.PHASE2_PRIORITY_CSV)
    eff = pd.read_csv(config.PHASE2_EFFICIENCY_CSV)
    return prio, eff


def budget_shares(county_scores: pd.DataFrame) -> pd.DataFrame:
    live = county_scores.groupby("metro")["risk_score"].sum()
    live_metros = live.drop(index="other_in", errors="ignore")
    live_metros = live_metros / live_metros.sum()
    w = config.DYNAMIC_WEIGHT
    rows = []
    for metro, static in config.STATIC_SHARES.items():
        dyn = float(live_metros.get(metro, 0))
        rows.append({"metro": metro, "static_share": static,
                     "live_risk_share": round(dyn, 3),
                     "blended_share": (1 - w) * static + w * dyn})
    df = pd.DataFrame(rows)
    df["blended_share"] = (df["blended_share"]
                           / df["blended_share"].sum()).round(3)
    df["shift_vs_static"] = (df["blended_share"]
                             - df["static_share"]).round(3)
    return df.sort_values("blended_share", ascending=False)


def county_targets(county_scores: pd.DataFrame, top_n: int = 30
                   ) -> pd.DataFrame:
    t = county_scores.head(top_n).copy()
    t["within_plan_weight"] = (t["risk_score"]
                               / t["risk_score"].sum()).round(3)
    t["ads_location"] = t["county"] + " County, Indiana"
    return t[["county", "metro", "risk_score", "weather_lift",
              "active_events", "trailing_weight", "within_plan_weight",
              "ads_location"]]


def cluster_mix(eff: pd.DataFrame) -> pd.DataFrame:
    e = eff.copy()
    e["mix"] = e.groupby("metro")["searches_per_1000usd"].transform(
        lambda s: s / s.sum())
    return e.sort_values(["metro", "mix"], ascending=[True, False])[
        ["metro", "cluster", "monthly_searches", "est_cpc", "mix"]]


def daypart(county_hourly: pd.DataFrame,
            county_scores: pd.DataFrame) -> pd.DataFrame:
    """Opportunity-weighted metro hourly risk -> hours above the 75th
    percentile with a +10%..+60% bid adjustment."""
    h = county_hourly.merge(
        county_scores[["county", "metro", "opportunity_score"]],
        on="county", how="left")
    h["w_risk"] = h["hour_risk"] * h["opportunity_score"]
    mh = (h.groupby(["metro", "time"])["w_risk"].sum()
          .rename("hour_risk").reset_index())
    out = []
    for metro, grp in mh.groupby("metro"):
        q75 = grp["hour_risk"].quantile(0.75)
        med = max(grp["hour_risk"].median(), 1e-9)
        hot = grp[grp["hour_risk"] >= q75].copy()
        hot["bid_adj_pct"] = ((hot["hour_risk"] / med - 1) * 100
                              ).clip(10, 60).round(0)
        out.append(hot)
    return pd.concat(out).sort_values(["metro", "time"])
